# =========================================================================
# NaviGuard AI — Environment Configuration Template
# Copy this file to .env.local (dev) or .env (production/docker-compose)
# =========================================================================

# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to browser build bundle)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. PRIVATE SERVER-SIDE VARIABLES (NEVER prefix with NEXT_PUBLIC_!)
# WARNING: Keep SUPABASE_SERVICE_ROLE_KEY secret. Bypasses database RLS policies.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-key-from-supabase-settings

# 3. OPTIONAL AI & MAP ROUTING INTEGRATIONS
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_OPENROUTESERVICE_KEY=your-openrouteservice-api-key

# 4. EMAIL DISPATCH (RESEND / SMTP FALLBACK)
RESEND_API_KEY=your-resend-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="NaviGuard Security" <your-email@gmail.com>

# 5. CAPACITOR / APK BUILD CONFIG
CAPACITOR_SERVER_URL=https://your-production-domain.vercel.app

