{
  "appId": "com.navguard.app",
  "appName": "NaviGuard",
  "webDir": "out",
  "server": {
    "url": "https://navguard-eight.vercel.app",
    "cleartext": false,
    "errorPath": "/error.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#090a0f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
